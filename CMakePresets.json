{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio 2026, x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows"
    },
    {
      "name": "windows-asan",
      "displayName": "Windows x64 with AddressSanitizer",
      "inherits": "windows",
      "binaryDir": "${sourceDir}/build/windows-asan",
      "cacheVariables": { "JMEVM_ASAN": "ON" }
    },
    {
      "name": "android-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_PLATFORM": "android-21",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (library)",
      "inherits": "android-base",
      "binaryDir": "${sourceDir}/build/android-arm64-v8a",
      "cacheVariables": { "ANDROID_ABI": "arm64-v8a" }
    },
    {
      "name": "android-x86_64",
      "displayName": "Android x86_64 (library, emulator)",
      "inherits": "android-base",
      "binaryDir": "${sourceDir}/build/android-x86_64",
      "cacheVariables": { "ANDROID_ABI": "x86_64" }
    }
  ],
  "buildPresets": [
    { "name": "windows", "configurePreset": "windows", "configuration": "Release" },
    { "name": "windows-asan", "configurePreset": "windows-asan", "configuration": "Debug" },
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "android-x86_64", "configurePreset": "android-x86_64" }
  ],
  "testPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    },
    {
      "name": "windows-asan",
      "configurePreset": "windows-asan",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 4 }
    }
  ]
}
